# Copy to .env and adjust. Defaults run locally with SQLite (zero setup).

# SQLite (default, zero-setup):
DATABASE_URL=sqlite:///./foodwaste.db
# PostgreSQL (production / resume stack), e.g. via docker-compose:
# DATABASE_URL=postgresql+psycopg://food:food@localhost:5432/food

MODEL_DIR=./models

# Business knobs
LEAD_TIME_DAYS=1
SERVICE_LEVEL_Z=1.65
FORECAST_HORIZON=7
